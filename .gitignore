# ==========================================================================
#  COPYRIGHTED GAME FILES — NEVER COMMIT THESE
# ==========================================================================
# You must dump these from your OWN copy of the Xbox 360 game.
# They must never be committed or distributed with this repository.
# NOTE: "private/*" (not "private/") so the !private/README.md negation
# below actually works — git can't re-include a file inside a directory
# that's excluded via a blanket "dir/" pattern, only via "dir/*".
private/*
*.xex
*.xexp
*.iso
*.god
*.xcp
default_patched.xex

# Generated recompiler output (regenerated from your XEX — not source)
WoSRecompLib/ppc/*.cpp
WoSRecompLib/ppc/*.h
WoSRecompLib/ppc/*.inc
WoSRecompLib/shaders/generated/

# Run logs (tools/run_logged.sh). Raw logs can be enormous, so they stay
# local; the generated *.summary.md files ARE committed and are what gets
# shared. Note this deliberately ignores "logs/*.log" rather than "logs/",
# so summaries pass through without needing a negation (a "dir/" pattern
# can't be un-excluded by a later "!dir/file" rule — see private/* above).
logs/*.log

# Build artifacts
build/
out/
cmake-build-*/
*.o
*.obj
*.exe
*.pdb
*.ilk

# Editor / OS cruft
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# But DO keep the placeholder READMEs / .gitkeep files in those dirs
!private/README.md
!WoSRecompLib/ppc/.gitkeep
